{
  "name": "r2index",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-31",
  "routes": [
    { "pattern": "r2index.elaunira.com/*", "zone_name": "elaunira.com" }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "r2index",
      "database_id": "42e34740-d515-4c03-aa75-0afbf21d4e7a"
    }
  ],
  // Configure your R2 buckets: the binding name must be the bucket name uppercased
  // with hyphens replaced by underscores (e.g., bucket "my-assets" → binding "MY_ASSETS").
  // This must match the bucket name stored in file records.
  "r2_buckets": [
    {
      "binding": "R2INDEX_E2E_TESTS",
      "bucket_name": "r2index-e2e-tests"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1
    }
  },
  // R2INDEX_WRITE_TOKEN (required): wrangler secret put R2INDEX_WRITE_TOKEN
  // R2INDEX_READ_TOKEN (optional, if unset read operations are public): wrangler secret put R2INDEX_READ_TOKEN
  "vars": {
    "CACHE_MAX_AGE": "60",
    "DOWNLOADS_RETENTION_DAYS": "365"
  }
}
