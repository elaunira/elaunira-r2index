{
  "name": "@elaunira/r2index",
  "version": "1.5.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "src",
    "!src/__tests__",
    "migrations"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply r2index --remote",
    "db:migrate:local": "wrangler d1 migrations apply r2index --local",
    "db:migrate:create": "wrangler d1 migrations create r2index",
    "db:migrate:list": "wrangler d1 migrations list r2index --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.11.8",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elaunira/elaunira-r2index.git"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.10",
    "@cloudflare/workers-types": "^4.20260206.0",
    "miniflare": "^4.20260205.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.63.0"
  }
}
