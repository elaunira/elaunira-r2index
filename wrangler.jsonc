{
  "name": "r2index",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-31",
  "routes": [
    { "pattern": "r2index.example.com/*", "zone_name": "example.com" }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "r2index",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],
  // Configure your R2 bucket: update bucket_name below
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "r2index-e2e-tests"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1
    }
  },
  // R2INDEX_WRITE_TOKEN (required): wrangler secret put R2INDEX_WRITE_TOKEN
  // R2INDEX_READ_TOKEN (optional, if unset read operations are public): wrangler secret put R2INDEX_READ_TOKEN
  "vars": {
    "CACHE_MAX_AGE": "60",
    "DOWNLOADS_RETENTION_DAYS": "365"
  }
}
